<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Title>EfCoreNexus</Title>
    <PackageId>EfCoreNexus.Framework</PackageId>
    <Authors>Thorsten Liborius</Authors>
    <Description>Less boilerplate. More Entity Framework. Optional helpers for Blazor apps using typed EF Core providers: inherit ready-to-use async CRUD instead of reimplementing it for every entity. No required repository interfaces or per-provider DI registration; safe per-operation DbContext handling. Native EF Core stays available; transactions are optional. Requires .NET 10 / EF Core 10.</Description>
    <PackageIcon>logo.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/thliborius/EfCoreNexus/</RepositoryUrl>
    <PackageProjectUrl>https://github.com/thliborius/EfCoreNexus/tree/v2.0.1</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageLicenseFile>license.txt</PackageLicenseFile>
    <Version>2.0.1</Version>
    <Copyright>Thorsten Liborius</Copyright>
    <PackageTags>EFCore;EntityFrameworkCore;Blazor;CRUD</PackageTags>
    <PackageReleaseNotes>2.0.1 patch release for .NET 10 / EF Core 10. Fixes CRUD tracking under global NoTracking (including owned-collection shadow keys), Added-entity ID delete, pending complex-property concurrency, and incompatible mapped subtype updates; entity discovery respects preconfigured complex types. No public API changes; updates with mismatched mapped subtypes are now rejected. See https://github.com/thliborius/EfCoreNexus/blob/v2.0.1/docs/release-notes-2.0.1.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../license.txt">
      <Pack>True</Pack>
      <PackagePath>/</PackagePath>
    </None>
    <None Include="../logo.png">
      <Pack>True</Pack>
      <PackagePath>/</PackagePath>
    </None>
    <None Include="../README.md">
      <Pack>True</Pack>
      <PackagePath>/</PackagePath>
    </None>
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
  </ItemGroup>

</Project>
