<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Title>EfCoreNexus</Title>
    <PackageId>EfCoreNexus.Framework</PackageId>
    <Authors>Thorsten Liborius</Authors>
    <Description>Less boilerplate. More Entity Framework. Optional helpers for Blazor apps using typed EF Core providers: inherit ready-to-use async CRUD instead of reimplementing it for every entity. No required repository interfaces or per-provider DI registration; safe per-operation DbContext handling. Native EF Core stays available; transactions are optional. Requires .NET 10 / EF Core 10.</Description>
    <PackageIcon>logo.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/thliborius/EfCoreNexus/</RepositoryUrl>
    <PackageProjectUrl>https://github.com/thliborius/EfCoreNexus/tree/v2.0.0</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageLicenseFile>license.txt</PackageLicenseFile>
    <Version>2.0.0</Version>
    <Copyright>Thorsten Liborius</Copyright>
    <PackageTags>EFCore;EntityFrameworkCore;Blazor;CRUD</PackageTags>
    <PackageReleaseNotes>Stable 2.0.0. Breaking changes from 1.0.5: requires .NET 10 / EF Core 10; native DbContext/IDbContextFactory and concrete provider DI replace legacy context, service and factory abstractions; async CRUD with cancellation and mapped entity keys replaces the old signatures; per-operation contexts and explicit transaction contexts replace implicit shared state. Full scalar updates, concurrency and missing-row contracts require migration review. Release notes: https://github.com/thliborius/EfCoreNexus/blob/v2.0.0/docs/release-notes-2.0.0.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../license.txt">
      <Pack>True</Pack>
      <PackagePath>/</PackagePath>
    </None>
    <None Include="../logo.png">
      <Pack>True</Pack>
      <PackagePath>/</PackagePath>
    </None>
    <None Include="../README.md">
      <Pack>True</Pack>
      <PackagePath>/</PackagePath>
    </None>
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
  </ItemGroup>

</Project>
