<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Title>EfCoreNexus</Title>
    <PackageId>EfCoreNexus.Framework</PackageId>
    <Authors>Thorsten Liborius</Authors>
    <Description>Less boilerplate. More Entity Framework. Small, optional EF Core helpers for Blazor: typed async CRUD, per-operation DbContext ownership, explicit assembly discovery and optional multi-provider transactions. Requires .NET 10 / EF Core 10; native EF APIs remain available.</Description>
    <PackageIcon>logo.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/thliborius/EfCoreNexus/</RepositoryUrl>
    <PackageProjectUrl>https://github.com/thliborius/EfCoreNexus/tree/v2</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageLicenseFile>license.txt</PackageLicenseFile>
    <Version>2.0.0-preview.1</Version>
    <Copyright>Thorsten Liborius</Copyright>
    <PackageTags>EFCore;EntityFrameworkCore;Blazor;CRUD</PackageTags>
    <PackageReleaseNotes>First v2 preview candidate for local validation; not published. Breaking changes from 1.0.5: .NET 10 / EF Core 10, native DbContextFactory setup, concrete provider DI, async CRUD and explicit transaction contexts replace the legacy service/factory hierarchy. Review migration and security contracts: https://github.com/thliborius/EfCoreNexus/blob/v2/docs/migration-v2.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../license.txt">
      <Pack>True</Pack>
      <PackagePath>/</PackagePath>
    </None>
    <None Include="../logo.png">
      <Pack>True</Pack>
      <PackagePath>/</PackagePath>
    </None>
    <None Include="../README.md">
      <Pack>True</Pack>
      <PackagePath>/</PackagePath>
    </None>
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
  </ItemGroup>

</Project>
