@inherits HomeComponent
@page "/"
<PageTitle>EfCoreNexus v2</PageTitle>
<h1>Less boilerplate. More Entity Framework.</h1>
<p>Interactive Server · SQLite · short-lived contexts</p>
<p role="status">@Status</p>
<fieldset disabled="@(Busy || !Interactive)">
    <label>New entry <input @bind="NewContent" /></label>
    <button @onclick="CreateAsync">Create</button>
    <button @onclick="CreatePairAsync">Create entry + memo (transaction)</button>
    <button @onclick="NativeDeactivateAsync">Deactivate all (native EF)</button>
    <button @onclick="ReloadAsync">Reload all</button>
    <button @onclick="ShowActiveAsync">Active only (LINQ)</button>
    <h2>Entries</h2>
    <p>Simple full scalar edits; these entries deliberately have no concurrency token.</p>
    <ul>
    @foreach (var item in TestList)
    {
        <li @key="item.TestId">
            @item.Content · @(item.Active ? "active" : "inactive")
            <button @onclick="() => EditAsync(item.TestId)">Edit</button>
            <button @onclick="() => DeleteAsync(item.TestId)">Delete by ID</button>
        </li>
    }
    </ul>
    @if (Edit is not null)
    {
        <label>Entry content <input @bind="Edit.Content" /></label>
        <button @onclick="SaveAsync">Save entry</button>
    }
    <h2>Memos: optimistic concurrency</h2>
    <p>Open this page in two tabs and load the same memo before saving in either tab.
        A stale save or snapshot delete reports a conflict. Reload explicitly to discard the edit.</p>
    <ul>
    @foreach (var memo in Memos)
    {
        <li @key="memo.Id">@memo.Text <button @onclick="() => EditMemoAsync(memo.Id)">Load memo</button></li>
    }
    </ul>
    @if (MemoEdit is not null)
    {
        <label>Memo text <input @bind="MemoEdit.Text" /></label>
        <button @onclick="SaveMemoAsync">Save memo</button>
        <button @onclick="DeleteMemoAsync">Delete snapshot</button>
    }
</fieldset>
